# MedAssist – Umgebungsvariablen (REQ-005)
# Diese Datei enthält bewusst KEINE Werte. Echte Werte nur als Vercel Environment
# Variables (getrennt nach Production / Preview / Development) bzw. lokal in
# apps/web/.env (wird nicht committet).

# PostgreSQL, EU-Region Frankfurt (z. B. Neon über den Vercel Marketplace)
DATABASE_URL=

# 32 Byte, Base64 – verschlüsselt TOTP-Secrets. Erzeugen: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Öffentliche Basis-URL der App (für Bestätigungslinks), z. B. http://localhost:3000
APP_URL=

# Folgt mit Meilenstein 6 (KI-Schicht)
ANTHROPIC_API_KEY=

# Folgt mit Meilenstein 5 (privater Objektspeicher in der EU)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
