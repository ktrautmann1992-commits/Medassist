# MedAssist – Umgebungsvariablen (REQ-005)
# Diese Datei enthält bewusst KEINE Werte. Echte Werte nur als Vercel Environment
# Variables (getrennt nach Production / Preview / Development) bzw. lokal in
# apps/web/.env (wird nicht committet).
#
# PFLICHT in allen Umgebungen: DATABASE_URL.
# TOTP_ENCRYPTION_KEY ist nur bei ZWEI_FA_AKTIV=true Pflicht; ist er gesetzt, muss er
# auch bei abgeschalteter 2FA gültig sein. Fehlt ein Pflichtwert oder ist ein Wert
# ungültig, startet der Server nicht (apps/web/instrumentation.ts, REQ-021).

# PostgreSQL, EU-Region Frankfurt (z. B. Neon über den Vercel Marketplace; die
# Neon-Integration setzt DATABASE_URL automatisch; Variablen-Präfix nicht ändern).
# Laufzeit-Verbindung der App (bei Neon: gepoolt).
DATABASE_URL=
# Optional: direkte (nicht gepoolte) Verbindung nur für Migrationen
# (`prisma migrate deploy`, REQ-022). Wird von der Neon-Integration mitgesetzt;
# fehlt sie, wird DATABASE_URL verwendet.
DATABASE_URL_UNPOOLED=

# 32 Byte, Base64 – verschlüsselt TOTP-Secrets. Nur bei ZWEI_FA_AKTIV=true Pflicht.
# Erzeugen: openssl rand -base64 32. Einmal genutzt, nicht mehr ändern: bereits
# gespeicherte TOTP-Secrets lassen sich sonst nicht mehr entschlüsseln.
TOTP_ENCRYPTION_KEY=

# Öffentliche Basis-URL der App (für Bestätigungslinks), z. B. https://medassist.example
# Nur in Production nötig. Fehlt sie, gilt: Preview → https://$VERCEL_BRANCH_URL,
# sonst https://$VERCEL_URL (beides setzt Vercel automatisch), lokal http://localhost:3000.
APP_URL=

# Zwei-Faktor-Anmeldung (TOTP): "true" oder "false". Leer/fehlend = false (Testphase).
# REQ-021: Vor Verarbeitung echter Daten MUSS hier "true" stehen.
ZWEI_FA_AKTIV=

# KI-Schicht: Google Gemini über Vertex AI (folgt mit Meilenstein 6)
# Google-Cloud-Projekt-ID
GOOGLE_CLOUD_PROJECT=
# EU-Region, vorgesehen: europe-west3 (Frankfurt) – Datenresidenz/AVV
GOOGLE_CLOUD_LOCATION=
# Modellname bewusst konfigurierbar, nicht im Code festgelegt
GEMINI_MODEL=
# Service-Account-JSON (einzeilig) – nur als Vercel Environment Variable, nie im Repository
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Meilenstein 5: Objektspeicher und Spracherkennung (REQ-406, REQ-408, REQ-412) ---
# Objektspeicher für Fotos und (kurzzeitig) Sprachaufnahmen: "aus" (Standard, leer = aus),
# "lokal" (NUR Entwicklung/Test, Dateisystem) oder "s3" (S3-kompatibler EU-Anbieter – Wahl offen).
# Ungültige Werte, "s3" ohne vollständige Variablen und "lokal" in Production/Vercel ⇒ Start bricht ab.
STORAGE_ANBIETER=
# Nur bei STORAGE_ANBIETER=s3 (alle Pflicht). Bucket privat, in der EU, CORS nur für die App-Domain (PUT/GET).
STORAGE_BUCKET=
STORAGE_REGION=
# https-URL des S3-kompatiblen Endpunkts (Pfad-Stil)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Nur bei STORAGE_ANBIETER=lokal (optional): HMAC-Schlüssel der signierten URLs (≥ 32 Byte, Base64;
# fehlt er, zufällig je Prozess) und Ordner (Standard: apps/web/.lokaler-speicher, gitignoriert).
STORAGE_LOKAL_SCHLUESSEL=
STORAGE_LOKAL_PFAD=

# Spracherkennung (STT): "aus" (Standard, leer = aus) oder "test" (fester Test-Text, NUR Entwicklung/E2E).
# Ein produktiver EU-Anbieter ist noch nicht gewählt (Entscheidung Product Owner, docs/risks.md).
# Die Browser-Web-Speech-API wird bewusst nicht verwendet (Audio an Dritte).
STT_ANBIETER=

# NUR für E2E-Tests mit `next start` (NODE_ENV=production): erlaubt die Test-Adapter "lokal"/"test".
# Auf Vercel nie setzen (Start bricht dort ab). Leer = false.
TESTADAPTER_ERLAUBT=

# QA N2 (optional): Wartezeit in ms auf die Zeilensperre eines Falls beim Speichern einer
# Antwort (100–60000, Standard 5000). Danach ein Wiederholungsversuch, dann Hinweis aus der
# Bewertung im Speicher.
EINGRENZUNG_SPERRE_MS=
