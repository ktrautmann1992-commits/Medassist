{
  "name": "medassist",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @medassist/web db:generate",
    "db:migrate": "pnpm --filter @medassist/web db:migrate",
    "db:validate": "pnpm --filter @medassist/web db:validate"
  },
  "devDependencies": {
    "turbo": "^2.11.6",
    "typescript": "5.9.3"
  }
}
